# AWS Configuration (required for Landsat download — usgs-landsat is Requester Pays)
# Option 1: Profile-based (preferred for local dev)
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-west-2

# Option 2: Key-based (use only for CI/CD, never in local dev)
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here

# EMR Serverless (Phase 5)
EMR_APPLICATION_ID=your_emr_serverless_app_id
EMR_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/emr-serverless-execution-role

# S3 paths
OUTPUT_S3_URI=s3://your-bucket/wildfire-risk-pipeline/outputs/
SEDONA_JOB_S3_URI=s3://your-bucket/wildfire-risk-pipeline/jobs/zonal_stats_job.py
STAC_S3_URI=s3://your-bucket/wildfire-risk-pipeline/stac/

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=wildfire-vegetation-risk
